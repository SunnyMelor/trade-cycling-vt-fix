+package de.maxhenkel.tradecycling.compatibility;
+
+import de.maxhenkel.tradecycling.TradeCyclingMod;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.entity.npc.Villager;
+import net.minecraft.world.item.trading.Merchant;
+import net.minecraft.world.item.trading.MerchantOffers;
+
+import javax.annotation.Nullable;
+import java.lang.reflect.Method;
+
+public class VisibleTraders {
+
+    @Nullable
+    private static Method regenerateTrades;
+    @Nullable
+    private static Method getCombinedOffers;
+    @Nullable
+    private static Method getShiftedLevel;
+    @Nullable
+    private static Method wrapAndSendMerchantOffers;
+
+    public static void forceTradeGeneration(Villager villager) {
+        if (regenerateTrades == null) {
+            return;
+        }
+        try {
+            regenerateTrades.invoke(villager);
+        } catch (Throwable e) {
+            TradeCyclingMod.LOGGER.error("Failed to regenerate visible traders trades", e);
+            regenerateTrades = null;
+        }
+    }
+
+    /**
+     * Sends the current trade offers of the villager to the player.
+     * If visible traders is installed, the not yet unlocked offers are included, so they stay visible after cycling.
+     */
+    public static void sendTrades(ServerPlayer player, Villager villager, int containerId) {
+        if (wrapAndSendMerchantOffers != null && sendWithLegacyMethod(player, villager, containerId)) {
+            return;
+        }
+        player.sendMerchantOffers(containerId, getOffers(villager), getLevel(villager), villager.getVillagerXp(), villager.showProgressBar(), villager.canRestock());
+    }
+
+    /**
+     * Visible traders versions before 0.1.3 wrap the packet themselves, but do not expose the combined offers.
+     */
+    private static boolean sendWithLegacyMethod(ServerPlayer player, Villager villager, int containerId) {
+        try {
+            wrapAndSendMerchantOffers.invoke(player, (Merchant) villager, containerId, villager.getOffers(), villager.getVillagerData().getLevel(), villager.getVillagerXp(), villager.showProgressBar(), villager.canRestock());
+            return true;
+        } catch (Throwable e) {
+            TradeCyclingMod.LOGGER.error("Failed to send visible traders offers", e);
+            wrapAndSendMerchantOffers = null;
+            return false;
+        }
+    }
+
+    private static MerchantOffers getOffers(Villager villager) {
+        if (getCombinedOffers == null) {
+            return villager.getOffers();
+        }
+        try {
+            return (MerchantOffers) getCombinedOffers.invoke(villager);
+        } catch (Throwable e) {
+            TradeCyclingMod.LOGGER.error("Failed to get visible traders offers", e);
+            getCombinedOffers = null;
+            return villager.getOffers();
+        }
+    }
+
+    private static int getLevel(Villager villager) {
+        if (getShiftedLevel == null) {
+            return villager.getVillagerData().getLevel();
+        }
+        try {
+            return (int) getShiftedLevel.invoke(villager);
+        } catch (Throwable e) {
+            TradeCyclingMod.LOGGER.error("Failed to get visible traders level", e);
+            getShiftedLevel = null;
+            return villager.getVillagerData().getLevel();
+        }
+    }
+
+    public static void init(TradeCyclingMod mod) {
+        if (!mod.isModLoaded("visibletraders")) {
+            return;
+        }
+        regenerateTrades = findVillagerMethod("visibleTrades$regenerateTrades", "visibleTraders$forceTradeGeneration");
+        getCombinedOffers = findVillagerMethod("visibleTraders$getCombinedOffers");
+        getShiftedLevel = findVillagerMethod("visibleTraders$getShiftedLevel");
+        wrapAndSendMerchantOffers = getWrapAndSendMerchantOffersMethod();
+        if (regenerateTrades == null) {
+            TradeCyclingMod.LOGGER.error("Failed to initialize visible traders integration: Could not find the trade regeneration method");
+        }
+        if (getCombinedOffers == null && wrapAndSendMerchantOffers == null) {
+            TradeCyclingMod.LOGGER.warn("Could not find the visible traders offers method, unlocked trades will not be shown after cycling");
+        }
+    }
+
+    /**
+     * Visible traders renamed its methods over time, so look up all known names.
+     */
+    @Nullable
+    private static Method findVillagerMethod(String... names) {
+        for (Method method : Villager.class.getDeclaredMethods()) {
+            if (method.getParameterCount() > 0) {
+                continue;
+            }
+            for (String name : names) {
+                if (method.getName().equals(name)) {
+                    method.setAccessible(true);
+                    return method;
+                }
+            }
+        }
+        return null;
+    }
+
+    @Nullable
+    private static Method getWrapAndSendMerchantOffersMethod() {
+        try {
+            Method method = ServerPlayer.class.getDeclaredMethod("visibleTraders$wrapAndSendMerchantOffers", Merchant.class, int.class, MerchantOffers.class, int.class, int.class, boolean.class, boolean.class);
+            method.setAccessible(true);
+            return method;
+        } catch (Throwable e) {
+            return null;
+        }
+    }
+
+}
